DATABASE_URL=postgresql+psycopg2://calendar:calendar@localhost:5440/campus_calendar
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720
DEFAULT_ORG_TIMEZONE=Asia/Kolkata
DEFAULT_ORG_ID=11111111-1111-1111-1111-111111111111
CALENDAR_MAX_RANGE_DAYS=62
STUDENT_REMINDER_LIMIT=50
NUDGE_TICK_SECONDS=60
CAMPUS_CALENDAR_ENABLED=true
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Public address of this API, used in calendar-sync (.ics) links. Leave empty locally.
PUBLIC_API_URL=
# Default calendar-sync range for a new college, in days (each college changes it in Settings).
FEED_PAST_DAYS=30
FEED_FUTURE_DAYS=365
